{
  "schemaVersion": 1,
  "type": "flow",
  "title": "How a batch run proceeds",
  "description": "imgen reads and validates the prompt file first; an invalid file stops the run with exit code 1 before any request. Every distinct model is then resolved once. The jobs run one after another, each with a counter such as [2/5]. A failed job is reported and the next one starts. After the last job imgen exits with code 1 if any job failed, otherwise with code 0.",
  "source": "src/main.rs (main, build_jobs, parse_prompt_file), as of 2026-10-26",
  "width": 720,
  "height": 880,
  "flow": {
    "nodes": [
      {
        "id": "file",
        "label": "Prompt file",
        "sublabel": "array or defaults + jobs",
        "kind": "start"
      },
      {
        "id": "valid",
        "label": "Valid?",
        "sublabel": "checked before any request",
        "kind": "decision"
      },
      {
        "id": "invalid",
        "label": "Stopped",
        "sublabel": "exit code 1, nothing sent",
        "kind": "end"
      },
      {
        "id": "models",
        "label": "Resolve models",
        "sublabel": "each one once",
        "kind": "io"
      },
      {
        "id": "jobs",
        "label": "Run jobs",
        "sublabel": "[1/n] … [n/n], errors reported"
      },
      {
        "id": "failed",
        "label": "Any job failed?",
        "kind": "decision"
      },
      {
        "id": "fail",
        "label": "Exit code 1",
        "sublabel": "One or more jobs failed",
        "kind": "end"
      },
      {
        "id": "ok",
        "label": "Exit code 0",
        "sublabel": "all images saved",
        "kind": "end"
      }
    ],
    "edges": [
      {
        "from": "file",
        "to": "valid"
      },
      {
        "from": "valid",
        "to": "invalid",
        "label": "no"
      },
      {
        "from": "valid",
        "to": "models",
        "label": "yes"
      },
      {
        "from": "models",
        "to": "jobs"
      },
      {
        "from": "jobs",
        "to": "failed"
      },
      {
        "from": "failed",
        "to": "fail",
        "label": "yes"
      },
      {
        "from": "failed",
        "to": "ok",
        "label": "no"
      }
    ],
    "mainPath": [
      "file",
      "valid",
      "models",
      "jobs",
      "failed",
      "ok"
    ],
    "orientation": "portrait"
  }
}
