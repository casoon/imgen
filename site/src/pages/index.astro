---
import { readFile } from 'node:fs/promises';
import {
  Badge,
  Badges,
  BuildOutput,
  Button,
  CodeBlock,
  Facts,
  Faq,
  Features,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/lib/url';
import config from 'virtual:casoon-pages/config';
import gallery from '../../../examples/gallery/gallery.json';
// Animated SVG built with castwright from site/captures/batch.terminal.yaml (see capture.sh).
import batchSvg from '../../captures/batch.svg?url';
import Diagram from '../components/Diagram.astro';
import { galleryImages } from '../showcase';

const strip = gallery.images.slice(0, 4).map((img) => ({
  ...img,
  image: galleryImages[`../../examples/gallery/${img.file}`],
  href: url(`showcase/gallery-${img.file.replace(/\.webp$/, '')}/`),
}));

const quickstart = `# Token from replicate.com/account/api-tokens
export REPLICATE_API_TOKEN="r8_your_token_here"

# One image with the default model (FLUX 1.1 Pro)
imgen "A sunset over the ocean" --out sunset.png

# Many images from a JSON file
imgen --prompt-file prompts.json`;

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;
---

<Base>
  <Hero
    title="Images from the command line."
    lead="imgen sends a prompt to any image model on Replicate, waits for the prediction and saves the result as PNG or WebP. It reads each model's schema to send the size the way that model expects, and runs whole batches from one JSON file."
  >
    <Install
      commands={[
        { label: 'sh', command: 'curl -fsSL https://raw.githubusercontent.com/casoon/imgen/master/install.sh | sh' },
        { label: 'cargo', command: 'cargo install --git https://github.com/casoon/imgen' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>v{config.version}</Badge>
      <Badge>Rust CLI</Badge>
      <Badge>macOS + Linux</Badge>
    </Badges>
    <img
      slot="output"
      class="terminal-demo"
      src={batchSvg}
      width="410.4"
      height="404"
      alt="Terminal: imgen --version prints imgen 0.3.1. cat jobs.json shows a prompt file with two jobs, the second without an out field. With a placeholder token exported, imgen --prompt-file jobs.json stops with Failed to parse prompt file jobs.json, caused by missing field out, before any API request. echo $? prints 1."
    />
  </Hero>

  <Facts
    items={[
      { value: '3', label: 'ways to send the image size, picked from the model schema' },
      { value: '2', label: 'prompt-file formats: plain array or defaults + jobs' },
      { value: '5', label: 'retries on HTTP 429, honouring Retry-After' },
      { value: '4', label: 'prebuilt release targets' },
    ]}
  />

  <BuildOutput
    heading="Made with imgen"
    caption="Made with imgen and ideogram-ai/ideogram-v3-quality. Generated once and committed, because generation needs a Replicate token; each image's prompt and command are in the showcase."
    file="examples/gallery/"
  >
    <ul class="strip">
      {
        strip.map((img) => (
          <li>
            <a href={img.href}>
              <img
                src={img.image?.src}
                width={img.image?.width}
                height={img.image?.height}
                alt={img.alt}
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </BuildOutput>

  <Features
    items={[
      {
        title: 'Any Replicate image model',
        body: 'Pass owner/name with --model or per job. imgen resolves the latest version itself; FLUX 1.1 Pro is the default.',
      },
      {
        title: 'Schema detection, not model lists',
        body: 'The model’s OpenAPI schema decides whether imgen sends exact pixels, the closest allowed aspect ratio, or plain width and height.',
      },
      {
        title: 'Batches that keep going',
        body: 'A JSON file runs many jobs with shared defaults. Progress shows as [2/5], and a failed job does not stop the rest.',
      },
    ]}
  />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <div class="text">
      <p>
        Image models on Replicate do not agree on how they take a size. imgen does not keep a
        list of models: it reads the input schema of the model you name and sends exact pixels,
        the closest allowed aspect ratio, or plain width and height, whichever the model accepts.
      </p>
      <p>
        Then it creates the prediction, polls until the image is ready and saves it. With
        <code>--webp</code>, models that can deliver WebP do so directly; for all others imgen
        converts the download locally.
      </p>
    </div>
    <Diagram name="how-it-works" format="svg" narrow={{ width: 320, height: 600 }} />
    <div class="links">
      <Button href={url('docs/guides/schema-detection/')} variant="secondary">Schema detection</Button>
      <Button href={url('docs/guides/batch-mode/')} variant="secondary">Batch mode</Button>
      <Button href={url('docs/reference/cli/')} variant="quiet">All options →</Button>
    </div>
  </section>

  <Quickstart
    lead="Three steps from install to a saved image. The documentation covers models, schema detection and batch files."
    steps={[
      'Install imgen with the install script, a release archive or Cargo.',
      'Export your Replicate token as <code>REPLICATE_API_TOKEN</code>.',
      'Run <code>imgen</code> with a prompt, or with <code>--prompt-file</code> for a batch.',
    ]}
  >
    <CodeBlock code={quickstart} lang="shell" title="terminal" label="Shell" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'Is imgen still maintained?',
        a: 'imgen is feature-complete and no longer actively developed. It works as documented against the Replicate API; issues and pull requests may not be answered.',
      },
      {
        q: 'Which platforms are supported?',
        a: 'The install script and prebuilt release binaries cover macOS and Linux (x86_64 and arm64). There is no Windows build, but "cargo install --git https://github.com/casoon/imgen" builds imgen from source on any platform Rust supports.',
      },
      {
        q: 'How does imgen handle Replicate rate limits?',
        a: 'On HTTP 429 responses, imgen respects the Retry-After header (falling back to 10 seconds) and retries up to 5 times before giving up. Each image generation then polls for up to 120 seconds, checking every 2 seconds.',
      },
      {
        q: 'Is imgen on crates.io?',
        a: 'No. The crate named "imgen" on crates.io is a different project. Install the binary with the install script or build it from source with Cargo.',
      },
    ]}
  />
</Base>

<style>
  /* Never scale the SVG beyond a readable terminal size. */
  .terminal-demo {
    display: block;
    width: 100%;
    max-width: 540px;
    height: auto;
    margin: 0 auto;
  }
  .how {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  .how h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr));
    gap: 14px;
    margin: 0;
    padding: 18px;
    list-style: none;
  }
  .strip a {
    display: block;
    border-radius: 10px;
  }
  .strip img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }
</style>
